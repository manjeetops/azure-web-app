{
    "title": "azure-web-app",
    "uid": "azure-web-app",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "10s",
    "time": { "from": "now-15m", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "CPU Usage",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "color": { "mode": "palette-classic" }
          }
        },
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"hello-world\", container!=\"\"}[2m])) by (pod)",
            "legendFormat": "{{ pod }}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Memory Usage",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": { "mode": "palette-classic" }
          }
        },
        "targets": [
          {
            "expr": "sum(container_memory_working_set_bytes{namespace=\"hello-world\", container!=\"\"}) by (pod)",
            "legendFormat": "{{ pod }}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Running Pods",
        "type": "stat",
        "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "green", "value": 1 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "count(kube_pod_status_phase{namespace=\"hello-world\", phase=\"Running\"})",
            "legendFormat": "Pods",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Requests per Second",
        "type": "timeseries",
        "gridPos": { "x": 6, "y": 8, "w": 9, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": { "mode": "palette-classic" }
          }
        },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{namespace=\"hello-world\"}[2m])) by (route, status_code)",
            "legendFormat": "{{ route }} {{ status_code }}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Response Latency (p50 / p95 / p99)",
        "type": "timeseries",
        "gridPos": { "x": 15, "y": 8, "w": 9, "h": 4 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "palette-classic" }
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{namespace=\"hello-world\"}[2m])) by (le))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"hello-world\"}[2m])) by (le))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=\"hello-world\"}[2m])) by (le))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ]
      },
      {
        "id": 6,
        "title": "CPU Limit Usage %",
        "type": "gauge",
        "gridPos": { "x": 0, "y": 12, "w": 6, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.7 },
                { "color": "red", "value": 0.9 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"hello-world\",container!=\"\"}[2m])) / sum(kube_pod_container_resource_limits{namespace=\"hello-world\",resource=\"cpu\"})",
            "legendFormat": "CPU %",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Memory Limit Usage %",
        "type": "gauge",
        "gridPos": { "x": 6, "y": 12, "w": 6, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.7 },
                { "color": "red", "value": 0.9 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "sum(container_memory_working_set_bytes{namespace=\"hello-world\",container!=\"\"}) / sum(kube_pod_container_resource_limits{namespace=\"hello-world\",resource=\"memory\"})",
            "legendFormat": "Memory %",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Pod Restarts",
        "type": "stat",
        "gridPos": { "x": 12, "y": 12, "w": 6, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "red", "value": 1 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"hello-world\"})",
            "legendFormat": "Restarts",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "title": "Packets Received",
        "type": "stat",
        "gridPos": { "x": 18, "y": 12, "w": 6, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": {
            "unit": "pps",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "blue", "value": 0 }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "sum(rate(container_network_receive_packets_total{namespace=\"hello-world\"}[2m]))",
            "legendFormat": "pkt/s",
            "refId": "A"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "pluginId": "prometheus",
          "label": "Datasource"
        }
      ]
    }
  }